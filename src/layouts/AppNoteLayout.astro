---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import StatusMark from '../components/StatusMark.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  headings: MarkdownHeading[];
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
  figureCaption?: string;
  wideFigure?: boolean;
}

const { entry, headings, prev, next, figureCaption, wideFigure = false } = Astro.props;
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2);
const hasFigure = Astro.slots.has('figure');
---

<BaseLayout title={`${d.title} · Adit Bansal`} description={d.lead} docLabel={`Application Note · ${d.name}`}>
  <article class="wrap note">
    <header class="note-head">
      <p class="an-line mono">
        <StatusMark status={d.status} />
        {d.statusNote && <span class="status-note">{d.statusNote}</span>}
      </p>
      <h1>{d.title}</h1>
      <p class="meta">
        <span>{d.org}</span>
        <span>{d.role}</span>
        <span class="mono">{d.dates}</span>
      </p>
      <span class="trace-rule" aria-hidden="true"></span>
      <p class="lead">{d.lead}</p>
    </header>

    <div class:list={['glance', { 'has-figure': hasFigure && !wideFigure }]}>
      <div class="table-scroll specs">
        <table class="ds">
          <caption><b>Table 1.</b> Key specifications.</caption>
          <thead>
            <tr><th scope="col">Parameter</th><th scope="col">Value</th><th scope="col">Conditions</th></tr>
          </thead>
          <tbody>
            {
              d.keySpecs.map((s) => (
                <tr>
                  <th scope="row" class="param">{s.param}</th>
                  <td class="value">{s.value}</td>
                  <td class="muted">{s.cond}</td>
                </tr>
              ))
            }
            <tr>
              <th scope="row" class="param">Stack</th>
              <td class="mono stack" colspan="2">{d.stack.join(' · ')}</td>
            </tr>
            {
              d.hardware && (
                <tr>
                  <th scope="row" class="param">Hardware</th>
                  <td colspan="2">{d.hardware}</td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>

      {
        hasFigure && (
          <figure class="fig">
            <slot name="figure" />
            <figcaption class="mono">
              <b>Figure 1.</b> {figureCaption}
            </figcaption>
          </figure>
        )
      }
    </div>

    <div class="body-grid">
      {
        toc.length > 3 && (
          <nav class="toc mono" aria-label="Contents">
            <p class="toc-h">Contents</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </div>

    <nav class="pager" aria-label="Other application notes">
      {
        prev ? (
          <a class="prev" href={`/notes/${prev.id}/`}>
            <span class="mono">← Previous</span>
            {prev.data.short}
          </a>
        ) : (
          <span />
        )
      }
      <a class="all mono" href="/#application-notes">All notes</a>
      {
        next ? (
          <a class="next" href={`/notes/${next.id}/`}>
            <span class="mono">Next →</span>
            {next.data.short}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .note-head {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) 0;
  }
  .an-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0 0 1rem;
    font-size: 0.875rem;
    max-width: none;
  }
  .status-note {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  h1 {
    font-size: clamp(2.25rem, 1.3rem + 4vw, 4.25rem);
    font-stretch: 72%;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 0.95;
    max-width: 18ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 1rem 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
    max-width: none;
  }
  .meta .mono {
    font-size: 0.875rem;
  }
  .trace-rule {
    margin-top: 1.25rem;
  }
  .lead {
    margin: 1.25rem 0 0;
    font-size: var(--step-2);
    line-height: 1.3;
    font-weight: 450;
    max-width: 52ch;
  }

  .glance {
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 72rem) {
    .glance.has-figure {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }
  .specs .param {
    font-weight: 550;
    width: 1%;
    white-space: nowrap;
    padding-right: 1.5rem;
  }
  .specs .value {
    color: var(--copper);
    white-space: normal;
    min-width: 6rem;
    max-width: 13rem;
  }
  .specs .muted {
    font-size: 0.875rem;
  }
  .specs .stack {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .fig {
    margin: 0;
    min-width: 0;
    padding-top: 1.6rem;
  }
  .fig figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .fig figcaption b {
    font-weight: 400;
    color: var(--ink);
  }

  .body-grid {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 64rem) {
    .body-grid:has(.toc) {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
    .toc {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
    .body-grid:has(.toc) .prose {
      grid-column: 2;
    }
  }
  .toc {
    font-size: 0.8125rem;
    border-top: 2px solid var(--rule-strong);
    padding-top: 0.75rem;
  }
  .toc-h {
    margin: 0 0 0.5rem;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc a {
    display: flex;
    gap: 0.6rem;
    padding-block: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }
  .toc a::before {
    content: counter(toc);
    color: var(--copper);
    min-width: 1rem;
  }
  .toc a:hover {
    color: var(--signal);
    text-decoration: underline;
  }

  .prose {
    counter-reset: sec;
    max-width: 50rem;
  }
  .prose :global(h2) {
    counter-increment: sec;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 2.75rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--copper);
    font-size: var(--step-2);
    font-stretch: 82%;
    scroll-margin-top: 1.5rem;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h2)::before {
    content: counter(sec);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--copper);
    min-width: 1.25rem;
  }
  .prose :global(ul) {
    margin: 0 0 1em;
    padding-left: 1.1rem;
    max-width: 68ch;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(li::marker) {
    color: var(--copper);
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--rule-strong);
    border-bottom: 2px solid var(--rule-strong);
    font-size: 0.9375rem;
    margin: 0.5rem 0 1.5rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .prose :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule-strong);
    white-space: nowrap;
  }
  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }
  .prose :global(td:first-child) {
    font-weight: 550;
  }
  @media (max-width: 40rem) {
    .prose :global(table) {
      font-size: 0.8125rem;
    }
    .prose :global(th),
    .prose :global(td) {
      padding-right: 0.6rem;
    }
  }
  .prose :global(code) {
    padding: 0.05em 0.3em;
    background: var(--paper-2);
    border-radius: 2px;
  }

  .pager {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--rule-strong);
    padding-top: 1.25rem;
  }
  .pager a {
    text-decoration: none;
    color: var(--ink);
  }
  .prev,
  .next {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-weight: 600;
  }
  .prev span,
  .next span {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--copper);
  }
  .next {
    text-align: right;
  }
  .prev:hover,
  .next:hover {
    color: var(--signal);
  }
  .all {
    font-size: 0.8125rem;
    color: var(--signal) !important;
    text-decoration: underline !important;
  }
  @media (max-width: 40rem) {
    .lead {
      font-size: var(--step-1);
    }
    .pager {
      grid-template-columns: 1fr 1fr;
    }
    .all {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
    }
    .specs thead {
      display: none;
    }
    .specs tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, max-content);
      gap: 0.15rem 1rem;
      padding-block: 0.55rem;
      border-bottom: 1px solid var(--rule);
    }
    .specs tr:last-child {
      border-bottom: 0;
    }
    .specs tr > * {
      border: 0 !important;
      padding: 0 !important;
      width: auto !important;
    }
    .specs .param {
      white-space: normal;
    }
    .specs .value {
      white-space: normal;
      text-align: right;
      max-width: 11rem;
    }
    .specs .muted {
      grid-column: 1 / -1;
    }
    .specs td[colspan] {
      grid-column: 1 / -1;
    }
  }
</style>
