---
interface Props {
  num: string;
  title: string;
  id: string;
}
const { num, title, id } = Astro.props;
---

<section class="ds-section" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}><span class="n mono">{num}</span>{title}</h2>
  <span class="trace-rule" aria-hidden="true"></span>
  <div class="ds-body">
    <slot />
  </div>
</section>

<style>
  .ds-section {
    padding-block: clamp(2.5rem, 1.8rem + 3vw, 4.5rem) 0;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--step-3);
    font-stretch: 82%;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .n {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--copper);
    letter-spacing: 0;
    min-width: 1.25rem;
  }
  .trace-rule {
    margin-top: 0.75rem;
  }
  .ds-body {
    padding-top: 1.5rem;
  }
</style>
