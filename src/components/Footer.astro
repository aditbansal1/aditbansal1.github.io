---
import { PART, REV, EMAIL, GITHUB, LINKEDIN, NAME } from '../data/site';
const year = new Date().getUTCFullYear();
---

<footer class="foot">
  <div class="wrap foot-inner">
    <p class="doc mono">{PART} · {NAME} · Rev {REV} · © {year}</p>
    <ul class="links mono">
      <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      <li><a href={GITHUB} rel="me noopener">GitHub</a></li>
      <li><a href={LINKEDIN} rel="me noopener">LinkedIn</a></li>
    </ul>
    <button type="button" class="theme mono" data-theme-toggle aria-pressed="false">
      <span class="sw" aria-hidden="true"></span>Dark mode
    </button>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    border-top: 2px solid var(--rule-strong);
    font-size: 0.75rem;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-block: 1.25rem 2rem;
  }
  .doc {
    margin: 0;
    color: var(--ink-2);
    letter-spacing: 0.04em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-block;
    padding-block: 0.4rem;
  }
  .theme {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--signal);
    color: var(--signal);
  }
  .sw {
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid currentColor;
    box-shadow: inset 0.375rem 0 0 currentColor;
    border-radius: 50%;
  }
  @media (max-width: 40rem) {
    .theme {
      margin-left: 0;
    }
  }
</style>
