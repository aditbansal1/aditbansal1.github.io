---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · No connect · Adit Bansal" description="Page not found.">
  <div class="wrap nc">
    <p class="mono code">404 · NC</p>
    <h1>No connect.</h1>
    <p>This pin isn’t wired to anything. The datasheet starts on the <a href="/">home page</a>, and the projects are in the <a href="/#application-notes">application notes</a>.</p>
  </div>
</BaseLayout>

<style>
  .nc {
    padding-block: clamp(3rem, 2rem + 6vw, 8rem);
  }
  .code {
    color: var(--copper);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: var(--step-4);
    font-stretch: 72%;
    font-weight: 700;
    line-height: 0.95;
    margin-bottom: 1.25rem;
  }
</style>
